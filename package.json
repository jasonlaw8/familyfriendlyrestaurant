{
  "name": "bay-area-family-eats",
  "version": "1.0.0",
  "description": "Backend API for Bay Area Family Eats - A family-friendly restaurant directory",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
